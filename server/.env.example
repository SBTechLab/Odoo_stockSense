# ── Server ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (each member uses their own local DB) ──
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/stocksense_dev?schema=public"

# ── Auth ── (use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ── SMTP (optional). If SMTP_HOST is empty, all emails (incl. OTP codes) are printed to the server console. ──
# Gmail: enable 2-Step Verification, create an App Password (Google Account → Security → App passwords),
# then use: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<you>@gmail.com  SMTP_PASS=<16-char app password>
# Never commit real credentials — keep them in server/.env only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <your-address@gmail.com>"
