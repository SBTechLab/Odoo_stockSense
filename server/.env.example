# ── Server ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (each member uses their own local DB) ──
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/stocksense_dev?schema=public"

# ── Auth ── (use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ── SMTP (optional). If SMTP_HOST is empty, OTPs are printed to the server console. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"
